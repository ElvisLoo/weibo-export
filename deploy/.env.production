# 生产环境参数（供 systemd 服务和 deploy.sh 读取）
# 修改后执行：sudo systemctl restart weibo-export

# 服务监听端口（Nginx 反代到这里）
PORT=8765

# 监听地址（仅本机，Nginx 在前面挡；不要改成 0.0.0.0 直接暴露）
HOST=127.0.0.1

# 导出目录（服务器部署填这里，桌面端留空走默认逻辑）
# 宝塔常见路径示例：/www/wwwroot/weibo-export/微博导出
# 留空 = Linux 用 ~/微博导出，Windows 用 D:\微博导出（无 D 盘则回退到文档目录）
EXPORT_DIR=/www/wwwroot/weibo-export/微博导出

# 数据库路径（留空 = 使用默认 ~/极客港微博导出/weibo.db）
DB_PATH=

# 每条抓取请求间隔（秒，防风控）
# 这个值前端可覆盖，这里只是默认值
CRAWL_INTERVAL=20

# uvicorn workers（单进程足够，多进程会丢失内存 job 状态）
WORKERS=1

# 日志级别
LOG_LEVEL=info
